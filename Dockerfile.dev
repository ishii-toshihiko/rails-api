# Dockerfile
FROM ruby:3.3.0-slim

WORKDIR /app

#必須パッケージのインストール
RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends \
      build-essential \
      libpq-dev \
      libxml2-dev \
      libxslt-dev \
      git \
      curl && \
    rm -rf /var/lib/apt/lists/*

COPY Gemfile Gemfile.lock ./
RUN bundle install

RUN rm -f /app/tmp/pids/server.pid
